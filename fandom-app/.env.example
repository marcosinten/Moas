# Copia este archivo como .env y completa DATABASE_URL (solo para trabajar en tu computadora).
# En Render estas variables se cargan en el panel, NO se sube el archivo .env.
PORT=3000
NODE_ENV=production
# Supabase -> boton "Connect" -> "Session pooler". Si la clave tiene simbolos (@ : / # ?) escribelos codificados (%40 %3A %2F %23 %3F).
DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres
SESSION_HOURS=12
# Solo si usas un Postgres local sin SSL: DB_SSL=false
